---
// Reusable list of question cards, used by the home page, category pages and "related questions".
import type { CollectionEntry } from 'astro:content';

interface Props {
  questions: CollectionEntry<'questions'>[];
}
const { questions } = Astro.props;
---
<ul class="space-y-4">
  {questions.map((q) => (
    <li class="rounded-xl border border-slate-200 p-5 transition hover:border-indigo-400 hover:shadow-sm dark:border-slate-800 dark:hover:border-indigo-400">
      <a href={`/questions/${q.id}/`} class="block">
        <h2 class="text-xl font-bold tracking-tight sm:text-2xl">{q.data.title}</h2>
        <p class="mt-2 leading-relaxed text-slate-600 dark:text-slate-400">{q.data.short_answer}</p>
      </a>
    </li>
  ))}
</ul>
