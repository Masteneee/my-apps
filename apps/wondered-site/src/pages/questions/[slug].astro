---
// The square brackets make this a dynamic route: one template, many pages.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import QuestionList from '../../components/QuestionList.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import SliderDemo from '../../components/SliderDemo.astro';
import { categoryLabel } from '../../lib/categories';
import { relatedQuestions } from '../../lib/discovery';

// For a static site, Astro must know every URL at build time.
// We return one entry per .mdx file, so a new file = a new page automatically.
export async function getStaticPaths() {
  const questions = await getCollection('questions');
  return questions.map((question) => ({
    params: { slug: question.id },
    props: { question, related: relatedQuestions(questions, question) },
  }));
}

const { question, related } = Astro.props;
const { title, category, short_answer, youtube_id, sources, date } = question.data;
// render() turns the MDX body into a component we can place on the page.
const { Content } = await render(question);
// The short answer doubles as the page description, and each question gets its own
// share image, made by src/pages/og/[slug].png.ts.
---
<Base title={title} description={short_answer} image={`/og/${question.id}.png`} type="article">
  <article>
    <a href={`/category/${category}/`} class="text-sm font-semibold uppercase tracking-widest text-indigo-600 hover:underline dark:text-indigo-300">
      {categoryLabel(category)}
    </a>
    <!-- data-pagefind-body: Pagefind only indexes what's inside this block,
         so search covers the title and short answer, not the long explanation. -->
    <div data-pagefind-body>
      <h1 class="mt-2 text-4xl font-extrabold leading-tight tracking-tight text-balance sm:text-5xl">{title}</h1>
      <p class="mt-6 rounded-xl border-l-4 border-indigo-500 bg-slate-100 p-5 text-lg leading-relaxed dark:bg-slate-900">
        <strong data-pagefind-ignore>Short answer:</strong> {short_answer}
      </p>
    </div>

    <!-- Renders nothing when youtube_id is empty. -->
    <YouTubeEmbed id={youtube_id} title={title} />

    <!-- Tailwind removes default heading/list styles, so we restyle MDX output here. -->
    <div class="mt-8 space-y-5 text-lg leading-8 text-slate-800 dark:text-slate-300 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:text-slate-900 dark:[&_h2]:text-slate-100 [&_ul]:list-disc [&_ul]:pl-6 [&_a]:text-indigo-600 dark:[&_a]:text-indigo-300 [&_a]:underline">
      <!-- components={...} makes these usable in any .mdx file without an import line. -->
      <Content components={{ SliderDemo }} />
    </div>

    <section class="mt-12 border-t border-slate-200 pt-6 dark:border-slate-800">
      <h2 class="text-lg font-bold">Sources</h2>
      <ul class="mt-2 list-disc pl-6 text-sm">
        {sources.map((url) => (
          <li><a href={url} class="break-all text-indigo-700 hover:underline dark:text-indigo-300" rel="noopener">{url}</a></li>
        ))}
      </ul>
      <p class="mt-4 text-xs text-slate-500 dark:text-slate-400">Published {date.toISOString().slice(0, 10)}</p>
    </section>

    {related.length > 0 && (
      <section class="mt-12">
        <h2 class="mb-4 text-2xl font-bold tracking-tight">More {categoryLabel(category).toLowerCase()} questions</h2>
        <QuestionList questions={related} />
      </section>
    )}
  </article>
</Base>
