---
// The shared frame for every page: <head>, header, footer.
// Pages put their own content where <slot /> is.
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import RandomButton from '../components/RandomButton.astro';
import { DEFAULT_SITE_URL, SITE_NAME, absoluteUrl, metaDescription, pageTitle } from '../lib/seo';

interface Props {
  title: string;
  description: string; // shown under the link in Google results and in share previews
  image?: string; // path of the share image, e.g. /og/why-is-the-sky-blue.png
  type?: 'website' | 'article';
}
const { title, description, image = '/og/site.png', type = 'website' } = Astro.props;

// Astro.site comes from SITE_URL (see astro.config.mjs). Search engines and social sites
// need full addresses (https://...), not just /questions/..., so we join them here.
const siteUrl = Astro.site?.href ?? DEFAULT_SITE_URL;
const canonicalUrl = absoluteUrl(siteUrl, Astro.url.pathname);
const imageUrl = absoluteUrl(siteUrl, image);
const fullTitle = pageTitle(title);
const cleanDescription = metaDescription(description);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={cleanDescription} />
    <!-- canonical = "this is the one true address of this page", so search engines don't
         count /questions/a and /questions/a/ as two different pages. -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <!-- Open Graph tags: what Facebook, Discord, iMessage, LinkedIn... show when someone shares a link. -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={cleanDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <!-- X (Twitter) reads its own tag to show the big image version of the preview. -->
    <meta name="twitter:card" content="summary_large_image" />
    <!-- is:inline = run as-is, right here, before the page is drawn.
         Without this, dark mode users would see a white flash on every page load. -->
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (saved !== 'light' && prefersDark)) {
          document.documentElement.classList.add('dark');
          document.documentElement.dataset.pfTheme = 'dark'; // tells Pagefind's search box to go dark too
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-white font-sans text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <header class="border-b border-slate-200 dark:border-slate-800">
      <nav class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3 p-4">
        <a href="/" class="text-lg font-extrabold tracking-tight">Have You Ever Wondered?</a>
        <div class="flex flex-wrap items-center gap-2">
          <a href="/search/" class="rounded-full border border-slate-300 px-3 py-1 text-sm hover:bg-slate-100 dark:border-slate-600 dark:hover:bg-slate-800">Search</a>
          <a href="/suggest/" class="rounded-full border border-slate-300 px-3 py-1 text-sm hover:bg-slate-100 dark:border-slate-600 dark:hover:bg-slate-800">Suggest</a>
          <RandomButton />
          <ThemeToggle />
        </div>
      </nav>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-8">
      <slot />
    </main>
    <footer class="mx-auto max-w-3xl px-4 py-8 text-sm text-slate-500 dark:text-slate-400">
      Short, sourced answers to everyday questions.
      <a href="/suggest/" class="underline hover:text-slate-700 dark:hover:text-slate-200">Suggest a question</a>.
    </footer>
  </body>
</html>
