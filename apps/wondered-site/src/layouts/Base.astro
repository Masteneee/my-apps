---
// The shared frame for every page: <head>, header, footer.
// Pages put their own content where <slot /> is.
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Have You Ever Wondered</title>
  </head>
  <body class="bg-white text-slate-900">
    <header class="border-b border-slate-200">
      <nav class="mx-auto flex max-w-3xl items-center justify-between p-4">
        <a href="/" class="font-bold">Have You Ever Wondered?</a>
      </nav>
    </header>
    <main class="mx-auto max-w-3xl p-4">
      <slot />
    </main>
    <footer class="mx-auto max-w-3xl p-4 text-sm text-slate-500">
      Short, sourced answers to everyday questions.
    </footer>
  </body>
</html>
