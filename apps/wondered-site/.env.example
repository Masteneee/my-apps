# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Formspree form ID for the "Suggest a question" page.
# Create a free form at formspree.io; its endpoint looks like https://formspree.io/f/xyzabcde
# and the ID is the last part (xyzabcde). Leave empty to show a "coming soon" message instead.
PUBLIC_FORMSPREE_ID=

# The site's public address, used for canonical links, the sitemap and share image links.
# Leave empty to use the placeholder https://wondered-site.vercel.app (change it once you know the real one).
SITE_URL=
