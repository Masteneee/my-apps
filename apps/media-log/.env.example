# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard > Project Settings > API).
#
# Leave them empty (or don't create .env.local at all) to run in DEMO MODE:
# accounts and profiles are then saved only in your browser (localStorage).
#
# These two are safe to expose in the browser (that's what NEXT_PUBLIC_ means).
# The anon key can only do what your Row Level Security policies allow.
# NEVER put the "service_role" key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Search sources. No NEXT_PUBLIC_ prefix on purpose: these stay on the server
# (the route app/api/search) and are never sent to the browser.
# Any source left empty answers from a small saved SAMPLE instead, and the
# search page says so.
# ---------------------------------------------------------------------------

# TMDB (movies + series). Get it free at themoviedb.org > Settings > API.
# Fill in ONE of the two. The "API Read Access Token" (the long one) is
# recommended; the shorter "API Key" works too. If both are set, the token wins.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# IGDB (games). IGDB uses a Twitch developer app: dev.twitch.tv/console >
# Applications > Register Your Application (Client Type: Confidential).
# Copy its Client ID and generate a Client Secret. Both are needed.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# AniList (anime + manga) and Open Library (books) need no key. If they can't
# be reached, search falls back to their saved samples automatically.

# Set to 1 to make EVERY source use its saved sample (no network at all),
# e.g. offline, or to test the sample mode. Leave empty normally.
MEDIA_LOG_USE_SAMPLES=
