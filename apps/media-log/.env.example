# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard > Project Settings > API).
#
# Leave them empty (or don't create .env.local at all) to run in DEMO MODE:
# accounts and profiles are then saved only in your browser (localStorage).
#
# These two are safe to expose in the browser (that's what NEXT_PUBLIC_ means).
# The anon key can only do what your Row Level Security policies allow.
# NEVER put the "service_role" key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TMDB (movie search). Get it free at themoviedb.org > Settings > API.
# Fill in ONE of the two. The "API Read Access Token" (the long one) is
# recommended; the shorter "API Key" works too. If both are set, the token wins.
# Leave both empty to search a saved SAMPLE of about a dozen movies instead.
#
# No NEXT_PUBLIC_ prefix on purpose: these stay on the server (the route
# app/api/movies/search) and are never sent to the browser.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
